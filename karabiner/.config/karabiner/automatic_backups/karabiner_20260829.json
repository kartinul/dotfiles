{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Map Right Command to Hyper",
                        "manipulators": [
                            {
                                "from": { "key_code": "right_command" },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_control", "left_command", "left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "right_command" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Cmd+F1 to Ctrl+Cmd+Shift+4 (screenshot selection to clipboard)",
