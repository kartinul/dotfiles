{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Right Cmd+N -> Ctrl+Right, Right Cmd+P -> Ctrl+Left",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["right_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "p",
                                    "modifiers": { "mandatory": ["right_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Cmd+M restores minimized window instead of minimizing",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "m",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "osascript -e 'tell application \"System Events\" to tell (first application process whose frontmost is true) to set value of attribute \"AXMinimized\" of (first window whose value of attribute \"AXMinimized\" is true) to false' 2>/dev/null || osascript -e 'tell application \"System Events\" to keystroke \"m\" using command down'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Fn+Cmd+F → toggle native fullscreen",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "f",
                                    "modifiers": {
                                        "mandatory": ["fn", "command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "osascript -e 'tell application \"System Events\"\n\tset frontApp to first application process whose frontmost is true\n\ttell frontApp\n\t\tset fsWindows to (every window whose value of attribute \"AXFullScreen\" is true)\n\t\tif (count of fsWindows) > 0 then\n\t\t\tset value of attribute \"AXFullScreen\" of (item 1 of fsWindows) to false\n\t\telse\n\t\t\tset value of attribute \"AXFullScreen\" of (front window) to true\n\t\tend if\n\tend tell\nend tell' 2>/dev/null" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Fn+Enter toggles Ghostty quick terminal",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["fn"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "grave_accent_and_tilde",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Cmd+F1 to Ctrl+Cmd+Shift+4 and Cmd+F2 to Ctrl+P",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "f1",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "4",
                                        "modifiers": ["left_control", "left_command", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f2",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "p",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "CAPS › ESC, CAPS+H/J/K/L › ←↓↑→, CAPS+D/U › PG↓↑",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "caps_lock pressed",
                                        "type": "variable_if",
                                        "value": 1
