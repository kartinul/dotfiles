<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A user LaunchAgent, not a system LaunchDaemon: it runs in your session as
     you, so nothing it writes needs root. `make agent` substitutes the binary
     and log paths below and installs this into ~/Library/LaunchAgents. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.xvpn</string>
  <key>ProgramArguments</key>
  <array>
    <string>__XVPN_BIN__</string>
    <string>--supervise</string>
  </array>
  <!-- xray and sing-box come from Homebrew; the agent's PATH is not your
       shell's, so without this it aborts on a missing dependency. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restarts the supervisor if it dies. The supervisor itself holds a
       single-instance lock, so this cannot produce two of them. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__XVPN_LOG__</string>
  <key>StandardErrorPath</key><string>__XVPN_LOG__</string>
</dict></plist>