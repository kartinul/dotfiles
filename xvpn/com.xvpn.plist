<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.xvpn</string>
  <!-- The Rust supervisor: it validates configs before applying them, watches
       child liveness, and reports observed rather than intended state. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kartinul/dotfiles/xvpn/bin/xvpn</string>
    <string>--supervise</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/xvpn-supervisor.log</string>
  <key>StandardErrorPath</key><string>/var/log/xvpn-supervisor.log</string>
</dict></plist>