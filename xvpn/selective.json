{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "tag": "remote", "type": "https", "server": "1.1.1.1", "detour": "xray" },
      { "tag": "local", "type": "local" }
    ],
    "rules": [
      { "process_path_regex": [".*/WhatsApp\\.app/.*"], "server": "remote" },
      { "process_name": ["curl", "git", "brew", "ssh", "node", "python3"], "server": "remote" }
    ],
    "final": "local"
  },
  "inbounds": [
    { "type": "tun", "address": ["172.19.0.1/30"], "auto_route": true }
  ],
  "outbounds": [
    { "type": "socks", "tag": "xray", "server": "127.0.0.1", "server_port": 10808 },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "find_process": true,
    "domain_resolver": {
      "remote": { "server": "remote" },
      "local": { "server": "local" }
    },
    "rules": [
      { "process_name": ["xray"], "outbound": "direct" },
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "process_path_regex": [".*/WhatsApp\\.app/.*"], "outbound": "xray" },
      { "process_name": ["curl", "git", "brew", "ssh", "node", "python3"], "outbound": "xray" }
    ],
    "final": "direct"
  }
}
